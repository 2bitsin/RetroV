ENTRY(startup)

MEMORY {  
  ROM (rx) : ORIGIN = 0xC0000, LENGTH = 32K  
}

SECTIONS {
  .text : AT(0xC0000) {
    _code_seg = . / 0x10;   
    *(.rodata)
		*(.rodata.*)
    *(.data)
    *(.text.prologue)
    *(.text)
    FILL(0x90);
    . = LENGTH(ROM);
  } > ROM

  /DISCARD/ : {
    *(.msdos_mz_reloc)
    *(.msdos_mz_reloc.*)
    *(.comment)
    *(.debug*)
  }

  _rom_len = SIZEOF(.text)/0x200;
}