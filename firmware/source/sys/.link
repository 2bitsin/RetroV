ENTRY(startup)

MEMORY {  
  ROM   (rx) : ORIGIN = 0xF0000, LENGTH = 64K
  EBDA  (rw) : ORIGIN = 0x9FC00, LENGTH = 1K
  STACK (rw) : ORIGIN = 0x00300, LENGTH = 256
}

OUTPUT_FORMAT("binary")

SECTIONS {
  .text : AT(0xF0000) {
    _code_seg = . / 0x10;
    FILL(0x90);
    *(.text)
    *(.rodata)
    *(.data)
    . = 0x10000 - 0x10;
  } > ROM

  .text.startup : AT(0xFFFF0) {    
    FILL(0x90);
    *(.text.startup)
    . = 0xF;
    BYTE(0x90);
  } > ROM

  .bss : {
    *(.bss)
    . = ALIGN(16);
  } > EBDA

  _ebda_seg  = ORIGIN(EBDA)/0x10;
  _ebda_len  = LENGTH(EBDA);
  _stack_seg = ORIGIN(STACK)/0x10;
  _stack_ptr = LENGTH(STACK);

  /DISCARD/ : {
    *(.comment)
    *(.debug*)
  }
}