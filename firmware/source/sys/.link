ENTRY(startup)

OUTPUT_FORMAT("msdos")

SECTIONS {
  . = 0x0000;
  .text : {
    *(.text)
    *(.text.*)
    *(.rodata)
    *(.rodata.*)
    *(.data)
    *(.data.*)
    FILL(0x90);
    . = 0xFFF0;
    *(.startup)    
  } 

  .msdos_mz_reloc : {
    *(.msdos_mz_reloc.*)
    *(.msdos_mz_reloc)
  }

  /DISCARD/ : {
    *(.comment)
    *(.debug*)
  }
}