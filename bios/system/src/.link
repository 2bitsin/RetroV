ENTRY(reset_vec)

MEMORY {  
  ROM  (rx) : ORIGIN = 0xF0000, LENGTH = 64K
  EBDA (rw) : ORIGIN = 0x9FC00, LENGTH = 1K
}

OUTPUT_FORMAT("binary")

SECTIONS {
  .text : AT(0xF0000) {
    FILL(0x90);
    _code_start = .;
    *(.text)
    *(.rodata)
    *(.data)
    _code_end = .;    
    . = 0x10000 - 0x10;
  } > ROM

  .text.reset_vec : AT(0xFFFF0) {    
    FILL(0x90);
    *(.text.reset_vec)
    . = 0xF;
    BYTE(0x0)
  } > ROM

  .bss : {
    _bss_start = .;
    *(.bss)
    _bss_end = .;
    . = ALIGN(16);
  } > EBDA

  /DISCARD/ : {
    *(.comment)
    *(.debug*)
  }
}