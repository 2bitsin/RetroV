ApiEntry:
  .Int10Handler:
    int     0x6d
    iret

  .Int6dHanlder:
    sti
    cld
    push    bp es ds dx cx bx si di ax
    mov     al,     ah
    cbw
    shl     ax,     1
    mov     si,     ax
    pop     ax        
    cmp     si,     3Ah
    jnb     .Done
    mov     ds,     [cs:.NullSegment]
    jmp     word [cs:.DispatchTable + si] 
  .Done:
    pop     di si bx cx dx ds es bp    
    iret    
     
  .NotImplemented:
    push    ds si
    mov     si,     cs
    mov     ds,     si
    mov     si,     Strings.Int10H_AhEq
    call    Debug.PrintString
    mov     cl,     8
    mov     ch,     16
    mov     bx,     ax
    call    Debug.PrintNumber
    mov     si,     Strings.DotSpace
    call    Debug.PrintString
    mov     si,     Strings.NotImplemented
    call    Debug.PrintString
    pop     si ds   
    jmp     .Done

  .NullSegment:
    dw      0
  .DispatchTable:
    dw      .NotImplemented
    dw      .NotImplemented
    dw      .NotImplemented
    dw      .NotImplemented 
