
Strings:
    .LoopBegin:   db "BigFingLoop starting...", 13, 10, 0
    .LoopEnd:     db "BigFingLoop ending...", 13, 10, 0
    .LoopTock:    db "BigFingLoop going: ", 0

    .Hello:       db "Booting HvDOS ..."    
    .CrLf:        db 13, 10, 0
    .IntV:        db "Interrupt vector: ", 0

    .OpROMInit:   db "Scanning for Option ROMs ...", 13, 10, 0
    .OpROMFound:  db "Option rom found at: ", 0     
    .OpROMDone:   db "Option rom init done.", 13, 10, 0
