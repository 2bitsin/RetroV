MSR:

  .Write:
    push      bp
    mov       bp,           sp
    xchg      [bp +  4],    eax
    xchg      [bp +  8],    edx
    xchg      [bp + 12],    ecx
    wrmsr
    xchg      [bp +  4],    eax
    xchg      [bp +  8],    edx
    xchg      [bp + 12],    ecx
    pop       bp
    ret       12

  .Read:
    push      bp
    mov       bp,           sp
    xchg      [bp +  4],    ecx
    rdmsr
    xchg      [bp +  4],    ecx
    pop       bp    
    ret       4