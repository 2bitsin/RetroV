Misc:
  .BigFingLoop:  
    push    ebx ecx

    mov     si,     Strings.LoopBegin    
    call    Debug.PrintString    

    mov     ebx,    0
  .BigFingLoopOuter:    
    mov     ecx,    0
  .BigFingLoopInner:
    dec     ecx
    jnz     .BigFingLoopInner

    mov     si,     Strings.LoopTock
    call    Debug.PrintString

    push    bx
    neg     bx
    mov     cx,     16
    call    Debug.PrintNumber
    pop     bx

    mov     si,     Strings.CrLf
    call    Debug.PrintString

    dec     ebx
    jnz     .BigFingLoopOuter

    mov     si,     Strings.LoopEnd
    call    Debug.PrintString

    pop     ecx ebx
    ret
