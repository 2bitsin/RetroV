    
Prologue:
  .Start:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs

    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    cld
    call        IVT.Initialize
    sti         
    mov         si,     BuildVars.TimeDate
    call        Debug.PrintString

    mov         si,     Strings.OpROMInit
    call        Debug.PrintString   
    
    call        OptionRom.Initialize

    int         0x00
    mov         ah,     0x05
    int         0x10
    int         0x01


    mov         si,     Strings.Hello
    call        Debug.PrintString   

    jmp         $
    

  .L2:
    hlt
    jmp         .L2

