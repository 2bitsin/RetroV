  align 16
IVT:
  rept 256 Number
  { 
    align 4
  .Entry#Number:
    pushad
    mov     ax,     Number-1
    jmp     .PrintInterrupt
  }

.PrintInterrupt:
  hypercall

  push      ds es

  push      cs cs
  pop       ds es   

  mov       si,     Strings.IntV
  call      Debug.PrintString
  
  ;         ax is already set to the interrupt number
  mov       cx,     16
  call      Debug.PrintNumber

  mov       si,     Strings.CrLf
  call      Debug.PrintString
  
  pop       es ds
  
  ;         EOI
  mov       al,     0x20
  out       0x21,   al
  out       0xa1,   al

  popad
  iret    

.Initialize:

  push      ds es si di cx

  lds       si,     [.SrcAddr]
  les       di,     [.DstAddr]
  mov       cx,     IVT_LENGTH/2
  rep       movsw

  pop       cx di si es ds
  ret


  align 16
.Initial:
  rept 256 Number
  {
    dw .Entry#Number, BIOS_SEGMENT
  }
.SrcAddr: 
  dw .Initial,BIOS_SEGMENT
.DstAddr: 
  dw 0, IVT_SEGMENT







  
