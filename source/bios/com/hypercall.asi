





define HYPERCALL_DEBUG byte 0xff
define HYPERCALL_DEBUG_TOGGLE_UNREAL_MODE word ((0xff*0x100) + 0x00)
define HYPERCALL_DEBUG_WRITE_LOG_CHAR word ((0xff*0x100) + 0x01)
define HYPERCALL_DEBUG_WRITE_LOG_STRING word ((0xff*0x100) + 0x02)
define HYPERCALL_DEBUG_WRITE_LOG_NUMBER word ((0xff*0x100) + 0x03)
define HYPERCALL_DEBUG_DEBUGGER_BREAK word ((0xff*0x100) + 0xff)

define HYPERCALL_VIDEO byte 0x00
define HYPERCALL_VIDEO_SET_MODE word ((0x00*0x100) + 0x00)
define HYPERCALL_VIDEO_MEMORY_MAP word ((0x00*0x100) + 0x01)
define HYPERCALL_VIDEO_SET_VIEW word ((0x00*0x100) + 0x02)

define VIDEO_MODE_CHARACTER_COLOR_8X8 word 0x00
define VIDEO_MODE_CHARACTER_COLOR_8X14 word 0x01
define VIDEO_MODE_CHARACTER_COLOR_8X16 word 0x02
define VIDEO_MODE_CHARACTER_COLOR_9X8 word 0x04
define VIDEO_MODE_CHARACTER_COLOR_9X14 word 0x05
define VIDEO_MODE_CHARACTER_COLOR_9X16 word 0x06
define VIDEO_MODE_GRAPHICAL_4BPP word 0x08
define VIDEO_MODE_GRAPHICAL_8BPP word 0x09
define VIDEO_MODE_GRAPHICAL_1BPP word 0x0A
define VIDEO_MODE_GRAPHICAL_2BPP word 0x0B
define VIDEO_MODE_GRAPHICAL_16BPP word 0x0C
define VIDEO_MODE_GRAPHICAL_24BPP word 0x0D
define VIDEO_MODE_GRAPHICAL_32BPP word 0x0E
define VIDEO_MODE_CHARACTER_MONO_8X8 word 0x10
define VIDEO_MODE_CHARACTER_MONO_8X14 word 0x11
define VIDEO_MODE_CHARACTER_MONO_8X16 word 0x12
define VIDEO_MODE_CHARACTER_MONO_9X8 word 0x14
define VIDEO_MODE_CHARACTER_MONO_9X14 word 0x15
define VIDEO_MODE_CHARACTER_MONO_9X16 word 0x16










