Debug:
  .PrintString:
    ; ds:si =-> StringZ
    push    esi edi ecx
    and     esi,    0xFFFF
    mov     edi,    ds    
    shl     edi,    4
    add     esi,    edi
    xor     ecx,    ecx 
    push    word 0xFF01
    hypercall
    add     sp,     2
    pop     ecx edi esi
    ret

  .PrintNumber:
    ; bl      -> Value [ cx > 0  ]
    ; bx      -> Value [ cx > 8  ]
    ; dx:bx   -> Value [ cx > 16 ]
    ; edx:ebx -> Value [ cx > 32 ]
    ; cl      -> Size => 1...64
    ; ch      -> Base => 2...16
    cmp     ch,     1
    ja      .PrintNumber.base_ok
    mov     ch,     16
  .PrintNumber.base_ok:
    push    word 0xFF02
    hypercall
    add     sp,     2
    ret

  .PrintChar:
    ; bl -> Char    
    push    word 0xFF03
    hypercall
    add     sp,     2    
    ret

