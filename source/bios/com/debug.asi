Debug:
  .PrintString:
    push    ecx esi edi ax dx es ds

    pop     es
    cld
    mov     cx,     0xffff
    mov     di,     si
    xor     al,     al
    repne   scasb
    mov     dx,     0xffff
    sub     dx,     cx
    dec     dx
    mov     cx,     dx

    and     ecx,    0xFFFF
    mov     di,     ds
    and     edi,    0xFFFF
    shl     edi,    4
    and     esi,    0xFFFF
    add     esi,    edi

    push    word 0xFF01
    hypercall
    add     sp,     2
   
    pop     es dx ax edi esi ecx
    ret

  .PrintChar:
    ; al = char    
    out     0xe9,   al
    ret

  .PrintHex16:
    ; ax = 16bit value
    ; cx = bits to print in 4 bit increments or 0 for default
    pusha
    or      cx,     cx 
    jnz     .PrintHex16.loop
    mov     cx,     16    
  .PrintHex16.loop:
    sub     cx,     4
    push    ax
    shr     ax,     cl
    and     ax,     0xf
    cmp     ax,     10
    jl      .PrintHex16.digit
    add     ax,     'A' - '0' - 10
  .PrintHex16.digit:
    add     ax,     '0'
    call    .PrintChar
    pop     ax
    test    cx,     cx
    jnz     .PrintHex16.loop
    popa
    ret

