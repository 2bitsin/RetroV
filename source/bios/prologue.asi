    
Prologue:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs

    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax


    cld
    call        IVT.Initialize

    mov         ecx,    0x40000080
    xor         edx,    edx
    mov         eax,    1
    wrmsr

    mov         ecx,    0x400000B0
    mov         eax,    0x0000180B
    xor         edx,    edx
    wrmsr

    mov         ecx,    0x400000B1
    mov         eax,    1000
    xor         edx,    edx
    wrmsr

    sti    

    call        Debug.BigFingLoop
   
    mov         si,     Strings.Hello
    call        Debug.PrintString   

  .L2:
    hlt
    jmp         .L2