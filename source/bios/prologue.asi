    
Prologue:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs

    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    cld
    call        IVT.Initialize


    xor         ax,     ax 
    mov         ds,     ax

    mov         word [0], CountIRQs
    mov         word [2], BIOS_SEGMENT

    sti         

    call        Debug.BigFingLoop   
    mov         si,     Strings.Hello
    call        Debug.PrintString   

  .L2:
    hlt
    jmp         .L2

CountIRQs:
    pusha
    push        ds   
    xor         ax,     ax
    mov         ds,     ax    
    inc         dword [0x400]
    jnz         .L1
    VMCallInstruction
  .L1:
    mov         ax,     0x20
    out         0x21,   al
    pop         ds
    popa
    iret
