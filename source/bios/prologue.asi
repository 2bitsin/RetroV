    
Prologue:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs
    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    cld
    call        IVT.Initialize

    mov         edx,    0x0
    mov         eax,    0xe0900
    mov         ecx,    0x0000001b
    wrmsr       

    sti

    call        Debug.BigFingLoop
   
    mov         si,     Strings.Hello
    call        Debug.PrintString   

  .L2:
    hlt
    jmp         .L2