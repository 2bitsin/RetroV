    
Prologue:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs
    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    cld
    call        IVT.Initialize
    sti
   
    mov         si,     Strings.Hello
    call        Debug.PrintString   

    push        ds si cx dx
    mov         si,     0x9FFF
    mov         ds,     si
    mov         si,     0xF
    cld
    mov         dx,     0xFFFF
    mov         cx,     0x10
    rep         outsw
    pop         dx cx si ds

  .L2:
    hlt
    jmp         .L2