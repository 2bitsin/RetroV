    
Prologue:
    cli
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    mov         ax,     cs

    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    cld
    call        IVT.Initialize


;    xor         ax,     ax 
;    mov         ds,     ax
;
;    mov         word [0], CountIRQs
;    mov         word [2], BIOS_SEGMENT

    sti         

;    call        Debug.BigFingLoop   
    mov         si,     Strings.Hello
    call        Debug.PrintString   
    cld    

    mov         di,     0xB000
    mov         es,     di

  .Hello_again:
    xor         di,     di    
    mov         cx,     0
  .Hello_loop:
    mov         ax,     0x0F00 + 'H'
    stosw
    out         0xe9,   al  

    mov         ax,     0x0F00 + 'e'
    stosw
    out         0xe9,   al  

    mov         ax,     0x0F00 + 'l'
    stosw
    out         0xe9,   al  

    mov         ax,     0x0F00 + 'l'
    stosw
    out         0xe9,   al  

    mov         ax,     0x0F00 + 'o'
    stosw
    out         0xe9,   al  

    mov         ax,     0x0F00 + '!'
    stosw
    out         0xe9,   al  
    mov         al,     10
    out         0xe9,   al

    loop        .Hello_loop

    ;mov         ecx,    0xDEADBEEF
    ;mov         eax,    [es:0]
    ;mov         edx,    [es:4]
    ;wrmsr

    jmp         .Hello_again

  .L2:
    hlt
    jmp         .L2

CountIRQs:
    pusha
    push        ds   
    xor         ax,     ax
    mov         ds,     ax    
    inc         dword [0x400]
    jnz         .L1
    VMCallInstruction
  .L1:
    mov         ax,     0x20
    out         0x21,   al
    pop         ds
    popa
    iret
