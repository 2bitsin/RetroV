    
Prologue:
    mov         sp,     STACK_SEGMENT
    mov         ss,     sp
    mov         sp,     STACK_OFFSSET

    push        ss
    pop         ss

    mov         ax,     cs
    mov         ds,     ax
    mov         es,     ax
    mov         fs,     ax
    mov         gs,     ax

    ; Make a big big loop
    mov         eax,    0xFFFFFFFF
  .L1:          
    mov         ecx,    0xFFFFFFFF
  .L0: 
    xor         edx,    eax
    loop        .L0
    dec         eax
    jnz         .L1
    ; End of big big loop

    cld
    call        IVT.Initialize

    mov         si,     Strings.Hello
    call        Debug.Print    

    int         0x19 ; BOOT
    hlt