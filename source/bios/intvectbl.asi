  align 16
IVT:
  rept 256 Number
  { 
    align 4
  .Entry#Number:
    push    ax
    mov     ax,     Number-1
    jmp     .PrintInterrupt
  }

  align 16
.Initial:
  rept 256 Number
  {
    dw .Entry#Number, BIOS_SEGMENT
  }

.SrcAddr: 
  dw .Initial,BIOS_SEGMENT
.DstAddr: 
  dw 0, IVT_SEGMENT

.Initialize:

  push      ds es si di cx

  lds       si,     [.SrcAddr]
  les       di,     [.DstAddr]
  mov       cx,     IVT_LENGTH/2
  rep       movsw

  pop       cx di si es ds
  ret

.PrintInterrupt:
  push      ds si    
  mov       si,     BIOS_SEGMENT
  mov       ds,     si
  mov       si,     Strings.IntV
  call      Debug.PrintString
  ;         ax is already set to the interrupt number
  call      Debug.PrintHex16
  mov       si,     Strings.CrLf
  call      Debug.PrintString
  pop       si ds
  pop       ax
  iret        









  
