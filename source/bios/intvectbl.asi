  align 16
IVT:
  rept 256 Number
  { 
    align 4
  .Entry#Number:
    push      word Number-1
    VMCallInstruction
    add       sp,         2
    iret
  }


  align 16
.Initial:
  rept 256 Number
  {
    dw .Entry#Number, BIOS_SEGMENT
  }

.SrcAddr: 
  dw .Initial,BIOS_SEGMENT
.DstAddr: 
  dw 0, IVT_SEGMENT

.Initialize:

  push      ds
  push      es
  push      si
  push      di
  push      cx        

  lds       si,     [.SrcAddr]
  les       di,     [.DstAddr]
  mov       cx,     IVT_LENGTH/2
  rep       movsw

  pop       cx
  pop       di
  pop       si
  pop       es
  pop       ds
  ret









  
