  align 16
IVT:
  rept 256 Number
  { 
    align 4
  .Entry#Number:
    pushad
    push    ds es fs gs

    mov     ax,     cs
    mov     es,     ax   
    mov     ds,     ax
    mov     fs,     ax
    mov     gs,     ax

    mov     ax,     Number-1
    jmp     .PrintInterrupt
  }

.PrintInterrupt:
  
  mov       si,     Strings.IntV
  call      Debug.PrintString
  
  ;         ax is already set to the interrupt number
  mov       cx,     16
  call      Debug.PrintHex16

  mov       si,     Strings.CrLf
  call      Debug.PrintString

  xor       eax,    eax 
  mov       [0xfee000b0], eax
  
  pop       gs fs es ds
  popad
  iret        

.Initialize:

  push      ds es si di cx

  lds       si,     [.SrcAddr]
  les       di,     [.DstAddr]
  mov       cx,     IVT_LENGTH/2
  rep       movsw

  pop       cx di si es ds
  ret


  align 16
.Initial:
  rept 256 Number
  {
    dw .Entry#Number, BIOS_SEGMENT
  }
.SrcAddr: 
  dw .Initial,BIOS_SEGMENT
.DstAddr: 
  dw 0, IVT_SEGMENT







  
