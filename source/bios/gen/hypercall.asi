





define HYPERCALL_DEBUG byte 0xff
define HYPERCALL_DEBUG_TOGGLE_UNREAL_MODE word ((0xff*0x100) + 0x00)
define HYPERCALL_DEBUG_WRITE_LOG_CHAR word ((0xff*0x100) + 0x01)
define HYPERCALL_DEBUG_WRITE_LOG_STRING word ((0xff*0x100) + 0x02)
define HYPERCALL_DEBUG_WRITE_LOG_NUMBER word ((0xff*0x100) + 0x03)
define HYPERCALL_DEBUG_DEBUGGER_BREAK word ((0xff*0x100) + 0xff)

define HYPERCALL_VIDEO byte 0x00
define HYPERCALL_VIDEO_SET_MODE word ((0x00*0x100) + 0x00)
define HYPERCALL_VIDEO_MEMORY_MAP word ((0x00*0x100) + 0x01)
define HYPERCALL_VIDEO_SET_VIEW word ((0x00*0x100) + 0x02)

define VIDEO_MODE_CHARACTER_8x8 word 0x0000
define VIDEO_MODE_CHARACTER_8x14 word 0x0001
define VIDEO_MODE_CHARACTER_8x16 word 0x0002
define VIDEO_MODE_CHARACTER_9x8 word 0x0003
define VIDEO_MODE_CHARACTER_9x14 word 0x0004
define VIDEO_MODE_CHARACTER_9x16 word 0x0005
define VIDEO_MODE_GRAPHICAL_4BPP word 0x0006
define VIDEO_MODE_GRAPHICAL_8BPP word 0x0007
define VIDEO_MODE_GRAPHICAL_1BPP word 0x0008
define VIDEO_MODE_GRAPHICAL_2BPP word 0x0009
define VIDEO_MODE_GRAPHICAL_16BPP word 0x000a
define VIDEO_MODE_GRAPHICAL_24BPP word 0x000b
define VIDEO_MODE_GRAPHICAL_32BPP word 0x000c

define VIDEO_MODE_FLAG_COLOR word 0x0001










