#include <win32/hresult_exception.hpp>
#include <win32/winhvp_partition.hpp>

#include <utility>

#include <Windows.h>
#include <WinHvPlatform.h>

winhvp_partition::winhvp_partition(winhvp const&)
	: m_handle{ nullptr } 
{
	if (auto error_code_v = WHvCreatePartition(&m_handle); error_code_v != S_OK) {
		throw hresult_exception(error_code_v);
	}
}

winhvp_partition::winhvp_partition(winhvp_partition&& from_v)
	: m_handle { std::exchange(from_v.m_handle, nullptr) }
{}

auto winhvp_partition::operator=(winhvp_partition&& from_v) 
	-> winhvp_partition&
{
	if (&from_v == this) 
		return *this;
	auto temp { std::move(from_v) };
	swap(temp);
	return *this;
}

void winhvp_partition::swap(winhvp_partition& other_v)
{
	std::swap(m_handle, other_v.m_handle);
}

winhvp_partition::~winhvp_partition() {
	if (m_handle != nullptr) {
		WHvDeletePartition(m_handle);
		m_handle = nullptr;
	}
}